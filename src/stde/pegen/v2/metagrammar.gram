# Note: Having a `\` in the result file near the top is expected, it's the first character of the @header raw string :)
@header r'''\
#from stde.pegen.v2.parser_old import memoize, memoize_left_rec, logger, DefaultParser, CharBasedParser #type:ignore
from ast import literal_eval
import ast
